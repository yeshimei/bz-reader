{
  "name": "bz-reader",
  "version": "0.1.1",
  "description": "EPUB / TXT 阅读器（Obsidian 插件），与 bz 生态联动。",
  "author": "叫我包仔",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs once",
    "watch": "node esbuild.config.mjs",
    "release": "node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "construct-style-sheets-polyfill": "^3.1.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "foliate-js": "1.0.1"
  }
}
